#setup
field=[["🌿","🌿","🌿"],["🌿","🌿","🌿"],["🌿","🌿","🌿"]]
print("Welcome to place the rabbit")
print(f"\n{field[0]}\n{field[1]}\n{field[2]}\n")
print(f"Where should the rabbit go? 🐇")
# user input and check it
row_column=input("Please choose a row and a column number: ")

while not (1 <= int(row_column[0]) <= 3) or not (1 <= int(row_column[1]) <= 3):
    print(f"Invalid input. Please choose numbers between 1 and 3.")
    row_column=input("Please choose a row and a column number: ")
else:
    row=int(row_column[0])-1
    column=int(row_column[1])-1
    field[row][column]="🐇"
    print(f"\n  Success...\n")
    print(f"{field[0]}\n{field[1]}\n{field[2]}")
